datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  SUCCESSFUL
  FAILED
  PENDING
}

enum VerificationType {
  REGISTRATION
  PASSWORD_RESET
}

model User {
  id                   String            @id @default(uuid())
  firstName            String?
  lastName             String?
  fullName             String?
  email                String            @unique
  phone                String            @unique
  password             String
  role                 Role              @default(CUSTOMER)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  accounts             Account[]
  sentTransactions     Transaction[]     @relation("SentTransactions")
  receivedTransactions Transaction[]     @relation("ReceivedTransactions")

  @@map("users")
}

model Account {
  id                   String            @id @default(uuid())
  userId               String
  accountNumber        String            @unique
  accountType          AccountType       @default(SAVINGS)
  balance              Decimal           @default(0.00) @db.Decimal(15, 2)
  currency             String            @default("NGN")
  status               AccountStatus     @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[]     @relation("FromAccount")
  incomingTransactions Transaction[]     @relation("ToAccount")

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id            String            @id @default(uuid())
  reference     String            @unique
  amount        Decimal           @db.Decimal(15, 2)
  type          TransactionType
  status        TransactionStatus @default(SUCCESSFUL)
  description   String?

  senderId      String?
  recipientId   String?
  fromAccountId String?
  toAccountId   String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sender        User?             @relation("SentTransactions", fields: [senderId], references: [id])
  recipient     User?             @relation("ReceivedTransactions", fields: [recipientId], references: [id])
  fromAccount   Account?          @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?          @relation("ToAccount", fields: [toAccountId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([senderId])
  @@index([recipientId])
  @@map("transactions")
}

model VerificationCode {
  id         String           @id @default(uuid())
  identifier String
  code       String
  type       VerificationType
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  @@index([identifier])
  @@map("verification_codes")
}
