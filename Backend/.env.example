PORT=5000
JWT_SECRET=replace-with-a-local-development-secret

# PostgreSQL is the default. For local SQLite, set DATABASE_PROVIDER=sqlite
# and use DATABASE_URL=file:./prisma/dev.db instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fhast_pay?schema=public"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fhast Pay <no-reply@example.com>"
OTP_TTL_MINUTES=10PORT=5000
